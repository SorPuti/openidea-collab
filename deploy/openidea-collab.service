[Unit]
Description=OpenIDEA collaboration relay
After=network.target

[Service]
Type=simple
User=openidea-collab
Group=openidea-collab
StateDirectory=openidea-collab
StateDirectoryMode=0700
Environment=COLLAB_BIND=127.0.0.1:4444
Environment=COLLAB_PUBLIC_ORIGIN=https://collab.synthosia.com
Environment=COLLAB_STATE_FILE=/var/lib/openidea-collab/metadata.json
ExecStart=/usr/local/bin/collab-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
TasksMax=32
MemoryMax=96M

[Install]
WantedBy=multi-user.target
